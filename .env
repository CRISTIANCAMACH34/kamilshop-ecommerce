# ==============================================================================
# KAMIL SHOP // CONFIGURACIÓN DE PRODUCCIÓN (SUPABASE & VERCEL)
# ==============================================================================

# 1. ENTORNO GENERAL DE LA APLICACIÓN
APP_ENV=production
DEBUG=false
SECRET_KEY=kamilshop_prod_secret_key_ultra_secure_hash_2026_xyz
PROJECT_NAME="KAMIL SHOP API"
API_V1_PREFIX=/api/v1
DOMAIN_NAME=kamilshop.store
SSL_EMAIL=admin@kamilshop.store
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,https://*.vercel.app,*

# 2. BASE DE DATOS (SUPABASE POSTGRESQL / SQLITE LOCAL FALLBACK)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kamilshop_secure_db_pass_2026
POSTGRES_HOST=aws-0-sa-east-1.pooler.supabase.com
POSTGRES_PORT=6543
DATABASE_URL=postgresql://kamilshop_admin:kamilshop_secure_db_pass_2026@postgres:5432/kamilshop_ecommerce

# 3. REDIS (CACHÉ DE ALTO RENDIMIENTO & BROKER DE CELERY)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kamilshop_redis_secret_2026
CELERY_BROKER_URL=redis://:kamilshop_redis_secret_2026@redis:6379/0
CELERY_RESULT_BACKEND=redis://:kamilshop_redis_secret_2026@redis:6379/1
REDIS_CACHE_URL=redis://:kamilshop_redis_secret_2026@redis:6379/2
CACHE_DEFAULT_TTL_SECONDS=300

# 4. PASARELA DE PAGO WOMPI COLOMBIA (BANCOLOMBIA, PSE, NEQUI, TARJETAS)
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_wompi_token_kamilshop
WOMPI_PRIVATE_KEY=prv_test_wompi_token_kamilshop
WOMPI_INTEGRITY_SECRET=secret_test_integridad_kamilshop
WOMPI_EVENT_SECRET=secret_event_webhook_kamilshop
WOMPI_API_URL=https://sandbox.wompi.co/v1

# 5. AUTENTICACIÓN SOCIAL: GOOGLE OAUTH
GOOGLE_CLIENT_ID=google_client_id_kamilshop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google_client_secret_kamilshop
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback

# 6. AUTENTICACIÓN SOCIAL: APPLE ID (SIGN IN WITH APPLE)
APPLE_TEAM_ID=apple_team_id_kamilshop
APPLE_CLIENT_ID=com.kamilshop.ecommerce.signin
APPLE_KEY_ID=apple_key_id_kamilshop
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nkamilshop\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost/api/v1/auth/apple/callback

# 7. AUTENTICACIÓN SOCIAL: FACEBOOK LOGIN (META FOR DEVELOPERS)
FACEBOOK_APP_ID=facebook_app_id_kamilshop
FACEBOOK_APP_SECRET=facebook_app_secret_kamilshop
FACEBOOK_REDIRECT_URI=http://localhost/api/v1/auth/facebook/callback

# 8. SERVICIO DE CORREO SMTP (HOSTINGER EMAIL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notificaciones@kamilshop.store
SMTP_PASSWORD=clave_buzon_kamilshop
SMTP_FROM_EMAIL=notificaciones@kamilshop.store
SMTP_FROM_NAME="KAMIL SHOP"
