{
  "version": 2,
  "installCommand": "npm --prefix frontend install --include=optional && chmod -R +x frontend/node_modules/.bin 2>/dev/null || true",
  "buildCommand": "chmod -R +x frontend/node_modules/.bin 2>/dev/null || true && cd frontend && npx vite build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
