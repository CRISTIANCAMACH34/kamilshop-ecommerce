# ==============================================================================
# E-COMERCE TIO Y CAMILA // CONFIGURACIÓN DE PRODUCCIÓN Y DESPLIEGUE (HOSTINGER)
# ==============================================================================
# Copia este archivo como .env en tu servidor y completa los tokens correspondientes.

# ------------------------------------------------------------------------------
# 1. ENTORNO GENERAL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
APP_ENV=production                  # development | staging | production
DEBUG=false
SECRET_KEY=cambiar_este_secreto_super_seguro_en_produccion_2026_camilaytio
PROJECT_NAME="E-COMERCE TIO Y CAMILA API"
API_V1_PREFIX=/api/v1
DOMAIN_NAME=tudominio.com           # Dominio apuntado en Hostinger (ej: camilaytio.com)
SSL_EMAIL=admin@tudominio.com       # Correo para certificados SSL gratuitos de Let's Encrypt

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com,http://localhost:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=camilaytio_ecommerce
POSTGRES_USER=camilaytio_admin
POSTGRES_PASSWORD=genera_una_clave_segura_para_la_bd_aqui_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Cadena de conexión para SQLAlchemy / asyncpg / psycopg2
DATABASE_URL=postgresql://camilaytio_admin:genera_una_clave_segura_para_la_bd_aqui_2026@postgres:5432/camilaytio_ecommerce

# ------------------------------------------------------------------------------
# 3. REDIS (CACHÉ DE ALTO RENDIMIENTO & BROKER DE CELERY)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=clave_redis_segura_2026_camilaytio
# URL para Celery Broker y Result Backend
CELERY_BROKER_URL=redis://:clave_redis_segura_2026_camilaytio@redis:6379/0
CELERY_RESULT_BACKEND=redis://:clave_redis_segura_2026_camilaytio@redis:6379/1
REDIS_CACHE_URL=redis://:clave_redis_segura_2026_camilaytio@redis:6379/2
CACHE_DEFAULT_TTL_SECONDS=300       # 5 minutos para catálogos y marcas

# ------------------------------------------------------------------------------
# 4. PASARELA DE PAGO WOMPI COLOMBIA (BANCOLOMBIA, PSE, NEQUI, TARJETAS)
# ------------------------------------------------------------------------------
# Obtenlos en: https://comercios.wompi.co/ (o https://sandbox.wompi.co/ para pruebas)
WOMPI_ENVIRONMENT=sandbox           # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_o_prod_pon_aqui_tu_llave_publica
WOMPI_PRIVATE_KEY=prv_test_o_prod_pon_aqui_tu_llave_privada
# Secreto para firmar el hash de integridad en transacciones
WOMPI_INTEGRITY_SECRET=secret_test_o_prod_integridad_aqui
# Secreto para validar que los webhooks provienen auténticamente de Wompi
WOMPI_EVENT_SECRET=secret_event_test_o_prod_aqui
WOMPI_API_URL=https://sandbox.wompi.co/v1   # En producción: https://production.wompi.co/v1

# ------------------------------------------------------------------------------
# 5. AUTENTICACIÓN SOCIAL: GOOGLE OAUTH
# ------------------------------------------------------------------------------
# Obtenlos en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=pon_aqui_tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=pon_aqui_tu_google_client_secret
GOOGLE_REDIRECT_URI=https://tudominio.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 6. AUTENTICACIÓN SOCIAL: APPLE ID (SIGN IN WITH APPLE)
# ------------------------------------------------------------------------------
# Obtenlos en: https://developer.apple.com/account/resources/identifiers/list
APPLE_TEAM_ID=pon_aqui_tu_team_id_de_apple_10_caracteres
APPLE_CLIENT_ID=com.camilaytio.ecommerce.signin
APPLE_KEY_ID=pon_aqui_tu_key_id_de_apple
# Contenido de la clave privada .p8 (reemplaza saltos de línea con \n o pega directo)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\npon_tu_clave_apple_aqui\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://tudominio.com/api/v1/auth/apple/callback

# ------------------------------------------------------------------------------
# 7. AUTENTICACIÓN SOCIAL: FACEBOOK LOGIN (META FOR DEVELOPERS)
# ------------------------------------------------------------------------------
# Obtenlos en: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=pon_aqui_tu_facebook_app_id
FACEBOOK_APP_SECRET=pon_aqui_tu_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://tudominio.com/api/v1/auth/facebook/callback

# ------------------------------------------------------------------------------
# 8. SERVICIO DE CORREO SMTP (HOSTINGER EMAIL O EXTERNO)
# ------------------------------------------------------------------------------
# Configuración recomendada para correo empresarial en Hostinger Titan Mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465                       # 465 (SSL) o 587 (STARTTLS)
SMTP_USER=notificaciones@tudominio.com
SMTP_PASSWORD=clave_del_buzon_hostinger
SMTP_FROM_EMAIL=notificaciones@tudominio.com
SMTP_FROM_NAME="E-COMERCE TIO Y CAMILA"
